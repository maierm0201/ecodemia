{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/environmental_news_homepage/code.html"
    },
    {
      "source": "/climate",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/wildlife",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/energy",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/living",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/tech",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/policy",
      "destination": "/category_page/code.html"
    },
    {
      "source": "/live",
      "destination": "/live_updates/code.html"
    },
    {
      "source": "/about",
      "destination": "/about_page/code.html"
    },
    {
      "source": "/impressum",
      "destination": "/imprint_page/code.html"
    },
    {
      "source": "/imprint",
      "destination": "/imprint_page/code.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/privacy_page/code.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy_page/code.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/article_view/code.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!admin/|admin$|api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
